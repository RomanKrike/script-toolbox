# Script Toolbox - Nuke mask export tree template
# Select one source node and run this script from a Script Toolbox button.

import nuke


def build_mask_tree():
    selected = nuke.selectedNodes()
    if len(selected) != 1:
        nuke.message("Select exactly one source node.")
        return

    source = selected[0]
    channels = sorted(
        channel for channel in source.channels()
        if channel.startswith("other.Mask_prop_")
    )

    if not channels:
        nuke.message("No other.Mask_prop_* channels found.")
        return

    dot = nuke.nodes.Dot()
    dot.setInput(0, source)
    dot.setXYpos(source.xpos() + 35, source.ypos() + 100)

    spacing = 180
    start_x = dot.xpos() - ((len(channels) - 1) * spacing) // 2

    for index, channel in enumerate(channels):
        x = start_x + index * spacing

        copy_node = nuke.nodes.Copy()
        copy_node.setInput(0, dot)
        copy_node.setInput(1, dot)
        copy_node["from0"].setValue(channel)
        copy_node["to0"].setValue("rgba.alpha")
        copy_node.setXYpos(x, dot.ypos() + 80)

        shuffle = nuke.nodes.Shuffle()
        shuffle.setInput(0, copy_node)
        shuffle["red"].setValue("alpha")
        shuffle["green"].setValue("alpha")
        shuffle["blue"].setValue("alpha")
        shuffle["label"].setValue("[value in]")
        shuffle["note_font"].setValue("Verdana Bold")
        shuffle.setXYpos(x, copy_node.ypos() + 55)

        unpremult = nuke.nodes.Unpremult()
        unpremult.setInput(0, shuffle)
        unpremult.setXYpos(x, shuffle.ypos() + 78)

        write = nuke.nodes.Write()
        write.setInput(0, unpremult)
        write["channels"].setValue("rgba")
        write["file_type"].setValue("png")
        if write.knob("create_directories"):
            write["create_directories"].setValue(True)
        if write.knob("checkHashOnRead"):
            write["checkHashOnRead"].setValue(False)
        if write.knob("in_colorspace"):
            write["in_colorspace"].setValue("scene_linear")
        if write.knob("out_colorspace"):
            write["out_colorspace"].setValue("scene_linear")

        short_name = channel.split(".", 1)[1]
        write["file"].setValue(
            "[python {nuke.script_directory()}]"
            "../../../../out/v001/tzypa/{0}.png".format(short_name)
        )
        write.setXYpos(x, unpremult.ypos() + 139)


build_mask_tree()
