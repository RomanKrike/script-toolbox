{"version":20,"sections":[{"kind":"folder","id":"folder_nuke_node_graph_tools","name":"nuke_node_graph_tools","label":"Nuke Node Graph Tools","folder_type":"collapsible","collapsed":false,"items":[{"kind":"row","id":"row_align_x","name":"align_x","label":"Align X","spacing":4,"equal_widths":false,"vertical_alignment":"center","items":[{"kind":"icon","id":"icon_align_left","name":"align_left","label":"Align Nodes - Left","path":"stsolar:align-left.svg","tooltip":"Align Nodes - Left","bindings":[{"id":"icon_align_left_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n v=[n.xpos()+n.screenWidth()*0.5 for n in ns];t=min(v)\n u=nuke.Undo();u.begin(\"Align Nodes - Left\")\n try:\n  for n in ns:n.setXpos(int(round(t-n.screenWidth()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_align_center_x","name":"align_center_x","label":"Align Nodes - Center X","path":"stsolar:align-horizontal-center.svg","tooltip":"Align Nodes - Center X","bindings":[{"id":"icon_align_center_x_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n v=[n.xpos()+n.screenWidth()*0.5 for n in ns];t=(min(v)+max(v))*0.5\n u=nuke.Undo();u.begin(\"Align Nodes - Center X\")\n try:\n  for n in ns:n.setXpos(int(round(t-n.screenWidth()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_align_right","name":"align_right","label":"Align Nodes - Right","path":"stsolar:align-right.svg","tooltip":"Align Nodes - Right","bindings":[{"id":"icon_align_right_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n v=[n.xpos()+n.screenWidth()*0.5 for n in ns];t=max(v)\n u=nuke.Undo();u.begin(\"Align Nodes - Right\")\n try:\n  for n in ns:n.setXpos(int(round(t-n.screenWidth()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]}]},{"kind":"row","id":"row_align_y","name":"align_y","label":"Align Y","spacing":4,"equal_widths":false,"vertical_alignment":"center","items":[{"kind":"icon","id":"icon_align_top","name":"align_top","label":"Align Nodes - Top","path":"stsolar:align-top.svg","tooltip":"Align Nodes - Top","bindings":[{"id":"icon_align_top_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n v=[n.ypos()+n.screenHeight()*0.5 for n in ns];t=min(v)\n u=nuke.Undo();u.begin(\"Align Nodes - Top\")\n try:\n  for n in ns:n.setYpos(int(round(t-n.screenHeight()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_align_center_y","name":"align_center_y","label":"Align Nodes - Center Y","path":"stsolar:align-vertical-center.svg","tooltip":"Align Nodes - Center Y","bindings":[{"id":"icon_align_center_y_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n v=[n.ypos()+n.screenHeight()*0.5 for n in ns];t=(min(v)+max(v))*0.5\n u=nuke.Undo();u.begin(\"Align Nodes - Center Y\")\n try:\n  for n in ns:n.setYpos(int(round(t-n.screenHeight()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_align_bottom","name":"align_bottom","label":"Align Nodes - Bottom","path":"stsolar:align-bottom.svg","tooltip":"Align Nodes - Bottom","bindings":[{"id":"icon_align_bottom_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n v=[n.ypos()+n.screenHeight()*0.5 for n in ns];t=max(v)\n u=nuke.Undo();u.begin(\"Align Nodes - Bottom\")\n try:\n  for n in ns:n.setYpos(int(round(t-n.screenHeight()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]}]},{"kind":"separator","id":"separator_layout","name":"layout_separator","label":"Layout"},{"kind":"row","id":"row_distribute","name":"distribute","label":"Distribute","spacing":4,"equal_widths":false,"vertical_alignment":"center","items":[{"kind":"icon","id":"icon_distribute_h","name":"distribute_horizontal","label":"Distribute Nodes Horizontally","path":"stsolar:align-horizontal-spacing.svg","tooltip":"Distribute Nodes Horizontally","bindings":[{"id":"icon_distribute_h_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<3:nuke.message(\"Select at least three nodes.\")\nelse:\n c=lambda n:n.xpos()+n.screenWidth()*0.5;ns.sort(key=c);a,b=c(ns[0]),c(ns[-1]);d=(b-a)/float(len(ns)-1)\n u=nuke.Undo();u.begin(\"Distribute Nodes Horizontally\")\n try:\n  for i,n in enumerate(ns):n.setXpos(int(round(a+d*i-n.screenWidth()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_distribute_v","name":"distribute_vertical","label":"Distribute Nodes Vertically","path":"stsolar:align-vertical-spacing.svg","tooltip":"Distribute Nodes Vertically","bindings":[{"id":"icon_distribute_v_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<3:nuke.message(\"Select at least three nodes.\")\nelse:\n c=lambda n:n.ypos()+n.screenHeight()*0.5;ns.sort(key=c);a,b=c(ns[0]),c(ns[-1]);d=(b-a)/float(len(ns)-1)\n u=nuke.Undo();u.begin(\"Distribute Nodes Vertically\")\n try:\n  for i,n in enumerate(ns):n.setYpos(int(round(a+d*i-n.screenHeight()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_mirror","name":"mirror_x","label":"Mirror Nodes","path":"stsolar:flip-horizontal.svg","tooltip":"Mirror Nodes","bindings":[{"id":"icon_mirror_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n l=min(n.xpos() for n in ns);r=max(n.xpos()+n.screenWidth() for n in ns);p=(l+r)*0.5\n u=nuke.Undo();u.begin(\"Mirror Nodes\")\n try:\n  for n in ns:\n   c=n.xpos()+n.screenWidth()*0.5;n.setXpos(int(round(2*p-c-n.screenWidth()*0.5)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]}]},{"kind":"row","id":"row_graph_tools","name":"graph_tools","label":"Graph Tools","spacing":4,"equal_widths":false,"vertical_alignment":"center","items":[{"kind":"icon","id":"icon_scale","name":"scale_nodes","label":"Scale Nodes","path":"stsolar:scaling.svg","tooltip":"Scale Nodes","bindings":[{"id":"icon_scale_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n p=nuke.Panel(\"Scale Nodes\");p.addSingleLineInput(\"Scale X\",\"1.25\");p.addSingleLineInput(\"Scale Y\",\"1.25\")\n if p.show():\n  try:sx,sy=float(p.value(\"Scale X\")),float(p.value(\"Scale Y\"))\n  except:nuke.message(\"Scale values must be numbers.\")\n  else:\n   l=min(n.xpos() for n in ns);r=max(n.xpos()+n.screenWidth() for n in ns);t=min(n.ypos() for n in ns);b=max(n.ypos()+n.screenHeight() for n in ns);px,py=(l+r)*0.5,(t+b)*0.5\n   u=nuke.Undo();u.begin(\"Scale Nodes\")\n   try:\n    for n in ns:\n     x=n.xpos()+n.screenWidth()*0.5;y=n.ypos()+n.screenHeight()*0.5\n     n.setXYpos(int(round(px+(x-px)*sx-n.screenWidth()*0.5)),int(round(py+(y-py)*sy-n.screenHeight()*0.5)))\n   finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_summon","name":"summon_nodes","label":"Summon Nodes","path":"stsolar:magnifier.svg","tooltip":"Summon Nodes","bindings":[{"id":"icon_summon_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif not ns:nuke.message(\"Select one or more nodes.\")\nelse:\n x,y=nuke.center()\n try:\n  try:from PySide6 import QtWidgets,QtGui\n  except ImportError:\n   try:from PySide2 import QtWidgets,QtGui\n   except ImportError:from PySide import QtGui;QtWidgets=QtGui\n  ds=[w for w in QtWidgets.QApplication.instance().allWidgets() if \"DAG\" in str(w.objectName()) and w.isVisible() and str(w.windowTitle())];d=next((w for w in ds if w.hasFocus()),ds[0] if ds else None)\n  if d:\n   q=d.mapFromGlobal(QtGui.QCursor.pos())\n   if d.rect().contains(q):\n    z=float(nuke.zoom());c=nuke.center();rc=d.rect().center();x=c[0]+(q.x()-rc.x())/z;y=c[1]+(q.y()-rc.y())/z\n except:pass\n l=min(n.xpos() for n in ns);r=max(n.xpos()+n.screenWidth() for n in ns);t=min(n.ypos() for n in ns);b=max(n.ypos()+n.screenHeight() for n in ns);dx=x-(l+r)*0.5;dy=y-(t+b)*0.5\n u=nuke.Undo();u.begin(\"Summon Nodes\")\n try:\n  for n in ns:n.setXYpos(int(round(n.xpos()+dx)),int(round(n.ypos()+dy)))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_relabel","name":"relabel_nodes","label":"Re-Label Nodes","path":"stsolar:clipboard.svg","tooltip":"Re-Label Nodes","bindings":[{"id":"icon_relabel_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=nuke.selectedNodes()\nif not ns:nuke.message(\"Select one or more nodes.\")\nelse:\n p=nuke.Panel(\"Re-Label Nodes\");p.addSingleLineInput(\"Label\",ns[0][\"label\"].value() if len(ns)==1 and \"label\" in ns[0].knobs() else \"\")\n if p.show():\n  v=p.value(\"Label\");u=nuke.Undo();u.begin(\"Re-Label Nodes\")\n  try:\n   for n in ns:\n    if \"label\" in n.knobs():n[\"label\"].setValue(v)\n  finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]}]},{"kind":"folder","id":"folder_backdrops","name":"backdrops","label":"Backdrops","folder_type":"collapsible","collapsed":true,"items":[{"kind":"row","id":"row_backdrops","name":"backdrop_actions","label":"Backdrop Actions","spacing":4,"equal_widths":false,"vertical_alignment":"center","items":[{"kind":"icon","id":"icon_auto_backdrop","name":"auto_backdrop","label":"Auto Backdrop","path":"stsolar:folder-open.svg","tooltip":"Auto Backdrop","bindings":[{"id":"icon_auto_backdrop_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif not ns:nuke.message(\"Select nodes to wrap in a backdrop.\")\nelse:\n l=min(n.xpos() for n in ns)-30;t=min(n.ypos() for n in ns)-70;r=max(n.xpos()+n.screenWidth() for n in ns)+30;b=max(n.ypos()+n.screenHeight() for n in ns)+30\n u=nuke.Undo();u.begin(\"Auto Backdrop\")\n try:nuke.nodes.BackdropNode(xpos=int(l),ypos=int(t),bdwidth=int(r-l),bdheight=int(b-t),label=\"\")\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_sort_backdrops","name":"sort_backdrops","label":"Sort Backdrops","path":"stsolar:alt-arrow-down.svg","tooltip":"Sort Backdrops","bindings":[{"id":"icon_sort_backdrops_click","event":"click","handler":"script","language":"python","script":"import nuke\nbs=list(nuke.allNodes(\"BackdropNode\"))\nif not bs:nuke.message(\"No backdrops found.\")\nelse:\n bs.sort(key=lambda n:float(n[\"bdwidth\"].value())*float(n[\"bdheight\"].value()),reverse=True);u=nuke.Undo();u.begin(\"Sort Backdrops\")\n try:\n  for i,n in enumerate(bs):n[\"z_order\"].setValue(i)\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]},{"kind":"icon","id":"icon_snap_backdrops","name":"snap_backdrops","label":"Snap Backdrops to Contents","path":"stsolar:crop.svg","tooltip":"Snap Backdrops to Contents","bindings":[{"id":"icon_snap_backdrops_click","event":"click","handler":"script","language":"python","script":"import nuke\nbs=list(nuke.selectedNodes(\"BackdropNode\")) or list(nuke.allNodes(\"BackdropNode\"))\nif not bs:nuke.message(\"No backdrops found.\")\nelse:\n alln=list(nuke.allNodes());u=nuke.Undo();u.begin(\"Snap Backdrops to Contents\")\n try:\n  for bd in bs:\n   x1,y1=bd.xpos(),bd.ypos();x2=x1+bd[\"bdwidth\"].value();y2=y1+bd[\"bdheight\"].value()\n   ns=[n for n in alln if n is not bd and n.Class()!=\"BackdropNode\" and x1<=n.xpos()+n.screenWidth()*0.5<=x2 and y1<=n.ypos()+n.screenHeight()*0.5<=y2]\n   if ns:\n    l=min(n.xpos() for n in ns)-30;t=min(n.ypos() for n in ns)-70;r=max(n.xpos()+n.screenWidth() for n in ns)+30;b=max(n.ypos()+n.screenHeight() for n in ns)+30\n    bd.setXYpos(int(l),int(t));bd[\"bdwidth\"].setValue(int(r-l));bd[\"bdheight\"].setValue(int(b-t))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]}]}]},{"kind":"folder","id":"folder_experimental","name":"experimental","label":"Experimental","folder_type":"collapsible","collapsed":true,"items":[{"kind":"icon","id":"icon_deintersect","name":"deintersect_nodes","label":"De-Intersect Nodes","path":"stsolar:broom.svg","tooltip":"De-Intersect Nodes","bindings":[{"id":"icon_deintersect_click","event":"click","handler":"script","language":"python","script":"import nuke\nns=[n for n in nuke.selectedNodes() if n.Class()!=\"BackdropNode\"]\nif len(ns)<2:nuke.message(\"Select at least two nodes.\")\nelse:\n ns.sort(key=lambda n:(n.ypos(),n.xpos()));p=12;u=nuke.Undo();u.begin(\"De-Intersect Nodes\")\n try:\n  for i,n in enumerate(ns):\n   for _ in range(100):\n    a=(n.xpos(),n.ypos(),n.xpos()+n.screenWidth(),n.ypos()+n.screenHeight());hit=None\n    for o in ns[:i]:\n     b=(o.xpos(),o.ypos(),o.xpos()+o.screenWidth(),o.ypos()+o.screenHeight())\n     if not(a[2]+p<=b[0] or b[2]+p<=a[0] or a[3]+p<=b[1] or b[3]+p<=a[1]):hit=o;break\n    if not hit:break\n    n.setYpos(int(hit.ypos()+hit.screenHeight()+p))\n finally:u.end()\n","label":"","mouse_button":"left","modifiers":[],"modifier_policy":"exact"}]}]}]}]}
