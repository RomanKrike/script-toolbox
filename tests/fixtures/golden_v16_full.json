{
  "version": 16,
  "sections": [
    {
      "kind": "folder",
      "id": "folder_main",
      "name": "main_tools",
      "label": "Main Tools",
      "folder_type": "collapsible",
      "collapsed": false,
      "items": [
        {
          "kind": "label",
          "id": "label_header",
          "name": "header",
          "label": "Render Controls"
        },
        {
          "kind": "string",
          "id": "string_asset",
          "name": "asset_name",
          "label": "Asset Name",
          "value": "Dragon",
          "on_change_script": "toolbox.set_result('status_text', value)"
        },
        {
          "kind": "integer",
          "id": "integer_samples",
          "name": "samples",
          "label": "Samples",
          "min": 1,
          "max": 64,
          "step": 1,
          "value": 8
        },
        {
          "kind": "float",
          "id": "float_exposure",
          "name": "exposure",
          "label": "Exposure",
          "min": -10.0,
          "max": 10.0,
          "step": 0.25,
          "decimals": 2,
          "value": 1.5
        },
        {
          "kind": "checkbox",
          "id": "checkbox_enabled",
          "name": "enabled",
          "label": "Enabled",
          "label_position": "right",
          "value": true
        },
        {
          "kind": "menu",
          "id": "menu_quality",
          "name": "quality",
          "label": "Quality",
          "items": ["Draft", "Preview", "Final"],
          "value": "Preview"
        },
        {
          "kind": "color",
          "id": "color_tint",
          "name": "tint",
          "label": "Tint",
          "value": [0.1, 0.5, 0.9]
        },
        {
          "kind": "field",
          "id": "field_nodes",
          "name": "nodes",
          "label": "Nodes",
          "source": "value",
          "value": ["pCube1", "pSphere1"],
          "multiple": true,
          "selectable": true,
          "select_scene": true,
          "display_mode": "list",
          "visible_rows": 5
        },
        {
          "kind": "button",
          "id": "button_state",
          "name": "render_state",
          "label": "Render State",
          "mode": "state",
          "language": "python",
          "state_get_script": "result = toolbox.get_value('enabled')",
          "state_on_script": "toolbox.set_value('enabled', True)",
          "state_off_script": "toolbox.set_value('enabled', False)",
          "state_on_label": "Rendering: ON",
          "state_off_label": "Rendering: OFF",
          "state_on_color": [0.2, 0.6, 0.3],
          "state_off_color": [0.3, 0.3, 0.3]
        },
        {
          "kind": "row",
          "id": "row_actions",
          "name": "actions",
          "label": "Actions",
          "spacing": 6,
          "equal_widths": true,
          "vertical_alignment": "center",
          "items": [
            {
              "kind": "button",
              "id": "button_run",
              "name": "run_render",
              "label": "Run",
              "language": "python",
              "click_script": "print('run')",
              "shift_script": "print('alternate')"
            },
            {
              "kind": "integer",
              "id": "integer_frames",
              "name": "frames",
              "label": "Frames",
              "min": 1,
              "max": 1000,
              "value": 100
            }
          ]
        },
        {
          "kind": "folder",
          "id": "folder_advanced",
          "name": "advanced",
          "label": "Advanced",
          "folder_type": "tabs",
          "items": [
            {
              "kind": "field",
              "id": "field_selection",
              "name": "selection",
              "label": "Selection",
              "source": "selection",
              "value": [],
              "multiple": true,
              "long_names": true,
              "display_mode": "list"
            },
            {
              "kind": "separator",
              "id": "separator_advanced",
              "name": "advanced_separator",
              "label": "Advanced Separator"
            }
          ]
        }
      ]
    },
    {
      "kind": "folder",
      "id": "folder_secondary",
      "name": "secondary",
      "label": "Secondary",
      "folder_type": "simple",
      "items": [
        {
          "kind": "button",
          "id": "button_cleanup",
          "name": "cleanup",
          "label": "Cleanup",
          "language": "python",
          "click_script": "print('cleanup')"
        }
      ]
    }
  ]
}
